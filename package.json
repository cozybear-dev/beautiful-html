{
  "name": "beautiful-html",
  "version": "0.1.0",
  "private": true,
  "description": "Hunt & Hackett's agent skill for well-designed, self-contained HTML reports",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "fetch": "node scripts/fetch-vendor.mjs && node scripts/fetch-fonts.mjs",
    "build": "node scripts/make-directions.mjs && node scripts/build-kit.mjs",
    "test": "node --test tests/unit/ tests/render/",
    "test:unit": "node --test tests/unit/",
    "zip": "node scripts/package-zip.mjs",
    "directions": "node scripts/make-directions.mjs",
    "examples": "node scripts/build-examples.mjs",
    "site": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cozybear-dev/beautiful-html.git"
  },
  "homepage": "https://github.com/cozybear-dev/beautiful-html"
}
